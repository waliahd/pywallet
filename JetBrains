                        <input type="number" id="fee" value="1.0" class="w-full bg-slate-800 border border-slate-700 rounded-lg px-4 py-2 text-white focus:outline-none focus:border-blue-500">
                    </div>
                    <button onclick="simulateSend()" class="w-full bg-gradient-to-r from-blue-600 to-blue-800 hover:from-blue-700 hover:to-blue-900 text-white font-bold py-3 rounded-lg transition transform hover:scale-[1.02]">
                        ٹرانزیکشن بھیجیں
                    </button>
                </div>
                <div class="bg-slate-900/50 rounded-lg p-4 font-mono text-sm text-green-400 overflow-y-auto max-h-80" id="console-output">
                    <div class="text-slate-500">// والٹ کنسول آؤٹ پٹ</div>
                    <div class="text-slate-500">// ٹرانزیکشن شروع کرنے کے لیے بٹن دبائیں...</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Security Warning -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="bg-red-900/20 border border-red-700 rounded-xl p-6">
            <h3 class="text-xl font-bold text-red-400 mb-2 flex items-center gap-2">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                حفاظتی نوٹ
            </h3>
            <p class="text-slate-300">
                ہم والٹ کے مالک نہیں ہوتے، ہم صرف "پرائیویٹ کیز" کے رکھوالے ہوتے ہیں۔ جب تک وہ 12 الفاظ یا پرائیویٹ کی آپ کے پاس محفوظ ہے، بٹ کوائن کے اس عظیم الشان عالمی ریاضیاتی سسٹم (Blockchain) میں موجود وہ مخصوص فنڈز صرف اور صرف آپ کے اشارے (ڈیجیٹل دستخط) پر حرکت کر سکتے ہیں۔
                کم بیٹری یا غیر مستحکم انٹرنیٹ پر ٹرانزیکشن نہ کریں۔
            </p>
        </div>
    </div>

    <!-- Copy Toast -->
    <div id="copy-toast" class="copy-toast">
        ایڈریس کاپی ہو گیا!
    </div>

    <script>
        function copyText(text) {
            navigator.clipboard.writeText(text).then(() => {
                const toast = document.getElementById('copy-toast');
                toast.classList.add('show');
                setTimeout(() => toast.classList.remove('show'), 2000);
            });
        }

        function switchTab(tab) {
            ['btc', 'evm', 'sol'].forEach(t => {
                document.getElementById(`content-${t}`).classList.add('hidden');
                document.getElementById(`tab-${t}`).classList.remove('tab-active');
                document.getElementById(`tab-${t}`).classList.add('bg-slate-800');
            });
            document.getElementById(`content-${tab}`).classList.remove('hidden');
            document.getElementById(`tab-${tab}`).classList.add('tab-active');
            document.getElementById(`tab-${tab}`).classList.remove('bg-slate-800');
        }

        function scrollToSection(id) {
            document.getElementById(id).scrollIntoView({ behavior: 'smooth' });
        }

        function logToConsole(msg, type = 'info') {
            const console = document.getElementById('console-output');
            const div = document.createElement('div');
            const colors = { info: 'text-blue-400', success: 'text-green-400', error: 'text-red-400', warn: 'text-amber-400' };
            div.className = `${colors[type]} mb-1`;
            div.textContent = `> ${msg}`;
            console.appendChild(div);
            console.scrollTop = console.scrollHeight;
        }

        function simulateSend() {
            const recipient = document.getElementById('recipient').value;
            const amount = document.getElementById('amount').value;
            const fee = document.getElementById('fee').value;
            const console = document.getElementById('console-output');
            console.innerHTML = '<div class="text-slate-500">// والٹ کنسول آؤٹ پٹ</div>';

            if (!recipient || !amount) {
                logToConsole('❌ براہ کرم ایڈریس اور رقم درج کریں۔', 'error');
                return;
            }

            logToConsole('والٹ لوڈ ہو رہا ہے...', 'info');
            setTimeout(() => {
                logToConsole('نیٹ ورک: bitcoin (Mainnet) | witness_type: p2tr', 'info');
            }, 500);
            setTimeout(() => {
                logToConsole('UTXO تلاش کیے جا رہے ہیں...', 'info');
            }, 1000);
            setTimeout(() => {
                logToConsole(`UTXO ملا: 500000 satoshis (Taproot)`, 'success');
            }, 1500);
            setTimeout(() => {
                logToConsole('Schnorr دستخط (Signature) تیار کیے جا رہے ہیں...', 'info');
            }, 2000);
            setTimeout(() => {
                logToConsole('✓ ٹرانزیکشن کامیابی سے سائن ہو گئی ہے۔', 'success');
            }, 2500);
            setTimeout(() => {
                logToConsole(`براڈکاسٹ: ${amount} satoshis -> ${recipient.substring(0, 10)}...`, 'info');
            }, 3000);
            setTimeout(() => {
                const txid = Array.from({length: 64}, () => Math.floor(Math.random()*16).toString(16)).join('');
                logToConsole(`✅ ٹرانزیکشن مین نیٹ پر بھیج دی گئی!`, 'success');
                logToConsole(`TXID: ${txid}`, 'success');
                logToConsole(`فیس: ${fee} sat/vB`, 'info');
            }, 3500);
        }
    </script>
</body>
</html>

